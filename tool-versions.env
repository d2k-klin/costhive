# CostHive tool pins — the single source of truth (addendum §8).
#
# Consumed by:
#   - Dockerfile              (build ARGs; installs runtime tools at these versions)
#   - .github/workflows/ci.yml (installs/verifies CI tools)
#   - scripts/verify-tools.sh  (asserts installed FinOps CLIs match their pins)
#
# Bumping any version here is a savings-impacting change (findings can change) —
# except AWS CLI and Gitleaks. Note FinOps bumps in CHANGELOG.md.
AWS_CLI_VERSION=2.36.44
STEAMPIPE_VERSION=2.4.6
STEAMPIPE_AWS_PLUGIN_VERSION=1.33.0
CUSTODIAN_VERSION=0.9.52
INFRACOST_VERSION=2.16.3
CLOUDQUERY_VERSION=6.42.2
KOMISER_VERSION=3.1.22
OPENCOST_VERSION=1.121.2
KRR_VERSION=1.30.0
GITLEAKS_VERSION=8.30.1
