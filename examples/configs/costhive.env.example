# Copy to .env and adjust. Used by docker-compose.
AWS_PROFILE=my-aws-profile
AWS_DEFAULT_REGION=us-east-1
# Infracost v2 API key (required by the estimate verb; run `infracost auth login`).
# INFRACOST_API_KEY=ico-xxxxxxxx
# Optional opt-in inputs:
# COSTHIVE_KOMISER_EXPORT=/data/komiser-resources.json
# COSTHIVE_CLOUDQUERY_DB_URL=postgres://user:pass@host:5432/cq
# COSTHIVE_KRR_EXPORT=/data/krr-report.json
