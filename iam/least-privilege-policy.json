{
  "Version": "2012-10-17",
  "Comment": "CostHive read-only cost-audit policy. Attach alongside the AWS-managed ViewOnlyAccess policy, which covers most describe/list/get calls. This adds the CloudWatch and inventory reads used by the current core checks. No write/delete actions are granted; Cloud Custodian runs in dry-run.",
  "Statement": [
    {
      "Sid": "CostHiveIdentityCheck",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostHiveCostWasteReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "ec2:DescribeAddresses",
        "ec2:DescribeRegions",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "rds:DescribeDBInstances",
        "elasticloadbalancing:DescribeLoadBalancers",
        "eks:DescribeCluster",
        "eks:ListClusters"
      ],
      "Resource": "*"
    }
  ]
}
